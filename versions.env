# Every version that goes into the VM Manager ISO, in one place.
# Read by m.sh (all build steps) and, inside the bundle, by installer/install.sh on the device.
# Change a version here, then run `./m.sh deps --lock` to re-pin the image digests in versions.lock.
#
# Compatibility checked 2026-10-19:
#   KubeVirt 1.9 supports Kubernetes 1.34-1.36   Calico 3.33 tested on 1.35-1.37
#   Rook 1.20.8 supports 1.31-1.37, Ceph 19/20   containerd 2.3 (LTS to 2028-04) for Kubernetes 1.36
#   runc 1.5.2 = the version containerd 2.3.7 is tested with

# --- Base OS -------------------------------------------------------------------------------
UBUNTU_RELEASE=24.04.5
UBUNTU_ISO_URL=https://releases.ubuntu.com/24.04/ubuntu-24.04.5-live-server-amd64.iso
UBUNTU_ISO_SHA256=97f3d7ffb032c3eb3b23d2c8be9cc76e60c2c1f2c0146ba5ba9fe01cafae0fd8
# Ubuntu packages come from the archive as it was at this moment (snapshot.ubuntu.com),
# so the same .deb versions are downloaded on any build machine, on any later date.
UBUNTU_SNAPSHOT=20261019T000000Z

# --- Built from apps/ (the git tag each source tree must be based on) ----------------------
KUBEVIRT_VERSION=v1.9.0
ROOK_VERSION=v1.20.8
VM_MANAGER_VERSION=1.0.2

# --- Kubernetes node -----------------------------------------------------------------------
K8S_VERSION=v1.36.5
CONTAINERD_VERSION=2.3.7
RUNC_VERSION=1.5.2

# --- Cluster add-ons (downloaded) ----------------------------------------------------------
CALICO_VERSION=v3.33.0
MULTUS_VERSION=v4.3.1
METRICS_SERVER_VERSION=v0.9.0
CDI_VERSION=v1.66.1
SNAPSHOTTER_VERSION=v8.6.0

# --- Other images (digests are pinned in versions.lock) ------------------------------------
CEPH_IMAGE=quay.io/ceph/ceph:v20.2.4
POSTGRES_IMAGE=docker.io/library/postgres:16
AGENT_IMAGE=docker.io/library/eclipse-temurin:25-jdk

# --- Build tools (used on the build machine only, not shipped) -----------------------------
# Rook v1.20.8 supports Go 1.25/1.26 (go.mod: go 1.25.0).
ROOK_GO_IMAGE=docker.io/library/golang:1.25-bookworm
DOCKER_CLI_IMAGE=docker.io/library/docker:29-cli
# Repacks the Ubuntu ISO (xorriso) and downloads .debs (apt) for the bundle.
UBUNTU_TOOLS_IMAGE=docker.io/library/ubuntu:24.04
