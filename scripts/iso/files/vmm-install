#!/usr/bin/env bash
# Set up this server as the first server of a new VM Manager cluster, offline, from
# /opt/vm-manager. Safe to run again: finished steps are skipped.
set -o pipefail
[ "$(id -u)" = 0 ] || exec sudo "$0" "$@"
INSTALLER=/opt/vm-manager/vm-manager/installer/install.sh
LOG=/var/log/vm-manager-install.log
# A damaged copy (e.g. an empty file after a power cut) would otherwise "succeed" doing nothing.
if [ ! -s "${INSTALLER}" ] || ! bash -n "${INSTALLER}"; then
    echo "The installer ${INSTALLER} is missing or damaged - reinstall from the VM Manager ISO." | tee -a "${LOG}" >&2
    exit 1
fi
"${INSTALLER}" create 2>&1 | tee -a "${LOG}"
